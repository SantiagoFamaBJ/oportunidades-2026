# Supabase (variables públicas — OK en el bundle del cliente)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role (PRIVADA — nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin auth (PRIVADAS — nunca usar prefijo NEXT_PUBLIC_)
DM_ADMIN_PASSWORD=tu-contraseña-segura-aqui
ADMIN_SESSION_SECRET=genera-con-openssl-rand-base64-32
